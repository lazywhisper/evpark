# Better Auth — обязательный секрет (32+ символа)
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:5173

# Anthropic — для Claude Vision и текст-анализа
# Можно через AI Gateway (рекомендуется — кеширование и логи)
ANTHROPIC_API_KEY=sk-ant-replace
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Telegram bot
# 1. Создаёшь бота через @BotFather, получаешь токен
# 2. Придумываешь любой webhook secret (32+ символа) и сохраняешь сюда
# 3. После деплоя зовёшь POST /api/tg/setup один раз для установки webhook
TG_BOT_TOKEN=000000:replace
TG_WEBHOOK_SECRET=replace_with_random_32_chars
TG_OWNER_CHAT_ID=

# av.by скрапинг (см. README): ScrapFly или Fly.io+Camoufox
# Если оба пустые — av.by временно отключается, остальные сайты работают
SCRAPFLY_KEY=
FLY_FALLBACK_URL=
FLY_FALLBACK_HMAC=
