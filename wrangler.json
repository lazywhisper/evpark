{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e39-hunter",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/api/index.ts",
  "workers_dev": true,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_TZ": "Europe/Minsk",
    "DEFAULT_THRESHOLD": "70",
    "VISION_MODEL": "claude-haiku-4-5",
    "TEXT_MODEL": "claude-haiku-4-5",
    "MIN_YEAR": "2001"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "e39-hunter-db",
      "database_id": "efc18d7b-d030-4509-9f98-652833fab610",
      "migrations_dir": "./src/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "e39-hunter-photos"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1543a2658ae4415581468dc10b927451"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "QUEUE_FETCH", "queue": "e39-fetch-listings" },
      { "binding": "QUEUE_SCORE", "queue": "e39-score-listing" },
      { "binding": "QUEUE_NOTIFY", "queue": "e39-notify" }
    ],
    "consumers": [
      {
        "queue": "e39-fetch-listings",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "e39-dlq"
      },
      {
        "queue": "e39-score-listing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "e39-dlq"
      },
      {
        "queue": "e39-notify",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "e39-dlq"
      }
    ]
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
